# -- LOGGING_LEVEL controls the verbosity of logs (TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOGGING_LEVEL=DEBUG

# -- BACKEND (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -- FRONTEND (NiceGUI): where the frontend reaches the backend
BACKEND_URL=http://localhost:8000

# -- Session cookie signing key. Set a random value if you expose this beyond a trusted network.
SESSION_SECRET=change_this_secret
