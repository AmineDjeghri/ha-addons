// Renovate configuration. The shared base (managers, grouping, release-age cooldown,
// badges) lives in https://github.com/AmineDjeghri/renovate-config (default.json5).
// Rules below are repo-specific and override the shared ones (later rules win).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>AmineDjeghri/renovate-config:default.json5"],

  packageRules: [
    // ---- Repo-specific rules (keep last) ----
    // Add-on Dockerfiles take their base image from `build.json` / `ARG BUILD_FROM`, which
    // upstream-bump.yml owns: it pins `:nightly` / `:dev` on purpose and bumps release pins itself.
    // Renovate must not pin digests on, or bump, those images.
    {
      description: "Add-on Dockerfiles are owned by upstream-bump.yml",
      matchManagers: ["dockerfile"],
      matchFileNames: ["addons/**"],
      enabled: false,
    },
  ],
}
